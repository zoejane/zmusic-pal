# Public frontend env for the static GitHub Pages build.
# No API keys. AI Pal is off (needs FastAPI; do not put Deepseek keys in the frontend).
#
# This file used to set NEXT_PUBLIC_API_URL to the Zeabur FastAPI host
# https://zmusic-pal-back.zeabur.app — that backend is no longer required
# for 查调 / 查和弦, and the static site does not call it.
NEXT_PUBLIC_ENABLE_AI_PAL=false
