# Frontend public env only. Never put Deepseek / Zhipu API keys here.
# AI Pal is off for GitHub Pages static hosting.

# NEXT_PUBLIC_ENABLE_AI_PAL=true
# NEXT_PUBLIC_API_URL=http://localhost:8000

